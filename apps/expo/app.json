{
  "expo": {
    "name": "Aftro",
    "slug": "aftro",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "kz.aftro.expo",
      "supportsTablet": true
    },
    "android": {
      "package": "kz.aftro.expo"
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "Aftro uses the camera to mark floor corners.",
        "recordAudioAndroid": false
      }],
      ["expo-sensors", { "motionPermission": "Aftro uses motion sensors to estimate room dimensions." }]
    ]
  }
}

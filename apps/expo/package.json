{
  "name": "aftro-expo",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": { "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0" },
  "scripts": {
    "prepare:preview": "node scripts/prepare-preview.mjs",
    "prestart": "npm run prepare:preview",
